# Backend security
SECRET_KEY=replace-with-a-long-random-flask-secret
JWT_SECRET_KEY=replace-with-a-long-random-jwt-secret
# Use HTTPS_ENABLED=true only when running local HTTPS with local cert files.
# Do not commit cert files.
HTTPS_ENABLED=false
SSL_CERT_FILE=certs/localhost.pem
SSL_KEY_FILE=certs/localhost-key.pem
WAF_BASE_URL=https://localhost:8081
# Set false for HTTP local development; true when using HTTPS locally or in production.
SESSION_COOKIE_SECURE=true
# Keep false for localhost. Enable HSTS only in real production HTTPS.
SECURITY_HEADERS_HSTS_ENABLED=false

# Local Docker defaults
FRONTEND_BASE_URL=https://localhost:5173
CORS_ALLOWED_ORIGINS=https://localhost:5173
VITE_API_BASE_URL=https://localhost:5000
VITE_SUPPORT_EMAIL=support@example.com
DATABASE_URL=sqlite:///sentinel_ai.db

# Optional admin bootstrap
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-local-password

# Optional email delivery
MAIL_SERVER=smtp.example.com
MAIL_PORT=465
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_DEFAULT_SENDER=noreply@example.com
MAIL_USE_TLS=false
MAIL_USE_SSL=true
EMAIL_NOTIFICATIONS_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=Sentinel AI

# Optional Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional PCAP tuning
TSHARK_TIMEOUT=1800
TSHARK_PACKET_LIMIT=0
TSHARK_READ_FILTER=
TSHARK_CHUNK_THRESHOLD_BYTES=4294967296
TSHARK_SPLIT_PACKETS_PER_FILE=100000
PCAP_PROTECT_ARTIFACTS=false
PCAP_ARTIFACT_ENCRYPTION_KEY=
PCAP_ARTIFACT_RETENTION_DAYS=7

# Route-specific rate limits. Defaults are safe for local development; tighten for public demos.
RATELIMIT_LOGIN=5 per minute;20 per hour
RATELIMIT_SIGNUP=3 per minute;10 per hour
RATELIMIT_REFRESH=30 per minute
RATELIMIT_AUTH_2FA=5 per minute;20 per hour
RATELIMIT_EMAIL_VERIFY=3 per minute;10 per hour
RATELIMIT_ADMIN_LOGIN=3 per minute;10 per hour
RATELIMIT_ADMIN_NOTIFICATION_TEST=3 per minute
RATELIMIT_ADMIN_EXPORT=10 per hour
RATELIMIT_ADMIN_DESTRUCTIVE=20 per hour
RATELIMIT_PASSWORD_CHECK=20 per minute
RATELIMIT_PASSWORD_CLEAR=5 per hour
RATELIMIT_VAULT_UPLOAD=10 per hour
RATELIMIT_VAULT_DOWNLOAD=30 per minute
RATELIMIT_VAULT_DELETE=20 per hour
RATELIMIT_PHISHING_SCAN=15 per minute
RATELIMIT_PHISHING_DELETE=20 per hour
RATELIMIT_IDENTITY_SCAN=5 per minute;30 per hour
RATELIMIT_IDENTITY_PROVIDER_SCAN=10 per hour
RATELIMIT_IDENTITY_DELETE=20 per hour
RATELIMIT_PCAP_ANALYZE=5 per hour
RATELIMIT_PCAP_ANALYZE_LOCAL=5 per hour
RATELIMIT_PCAP_POLL=120 per minute
RATELIMIT_PCAP_EXPORT=20 per hour
RATELIMIT_PCAP_CANCEL=20 per hour
RATELIMIT_REPORT_GENERATE=5 per hour
RATELIMIT_REPORT_EXPORT=20 per hour
RATELIMIT_GOOGLE_DRIVE_UPLOAD=5 per hour
RATELIMIT_CHATBOT_LLM=20 per hour
RATELIMIT_CHATBOT_DEBUG=30 per minute
RATELIMIT_CONTACT_SUPPORT_HOURLY=20 per hour

# Chatbot LLM providers
ENABLE_LLM_CHATBOT=true
ENABLE_RULE_BASED_FALLBACK=true
LLM_DEFAULT_PROVIDER=auto
LLM_ALLOWED_PROVIDERS=auto,ollama,gemini,fallback
LLM_AUTO_PRIORITY=ollama,gemini,fallback

# Ollama
OLLAMA_ENABLED=true
# Docker Compose backend containers should use http://host.docker.internal:11434.
# For direct non-Docker backend runs on the same machine as Ollama, use http://localhost:11434.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=600

# Gemini - backend only. Never expose this in Vite/React env.
GEMINI_ENABLED=true
GEMINI_API_KEY=YOUR_BACKEND_ONLY_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=45

# Optional Google Drive report upload
# Keep real service-account JSON files out of git and Docker build context.
GOOGLE_DRIVE_UPLOADS_ENABLED=false
GOOGLE_DRIVE_SERVICE_ACCOUNT_FILE=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_MAKE_PUBLIC=false
